<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ParallelDemo"
  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_ParallelDemo" name="设备并行配置流程" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_DeviceSelect" name="设备选择" />
    <bpmn:parallelGateway id="Gateway_Fork" name="并行拆分" />
    <bpmn:userTask id="Task_Network" name="网络配置" />
    <bpmn:userTask id="Task_Params" name="参数配置" />
    <bpmn:userTask id="Task_Auth" name="权限配置" />
    <bpmn:parallelGateway id="Gateway_Join" name="并行合并" />
    <bpmn:userTask id="Task_Finish" name="执行完成" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />

    <bpmn:sequenceFlow id="Flow_Start_Device" sourceRef="StartEvent_1" targetRef="Task_DeviceSelect" />
    <bpmn:sequenceFlow id="Flow_Device_Fork" sourceRef="Task_DeviceSelect" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Network" sourceRef="Gateway_Fork" targetRef="Task_Network" />
    <bpmn:sequenceFlow id="Flow_Fork_Params" sourceRef="Gateway_Fork" targetRef="Task_Params" />
    <bpmn:sequenceFlow id="Flow_Fork_Auth" sourceRef="Gateway_Fork" targetRef="Task_Auth" />
    <bpmn:sequenceFlow id="Flow_Network_Join" sourceRef="Task_Network" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Params_Join" sourceRef="Task_Params" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Auth_Join" sourceRef="Task_Auth" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_Finish" sourceRef="Gateway_Join" targetRef="Task_Finish" />
    <bpmn:sequenceFlow id="Flow_Finish_End" sourceRef="Task_Finish" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ParallelDemo">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
