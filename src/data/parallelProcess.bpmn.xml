      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Params_Join_di" bpmnElement="Flow_Params_Join">
        <di:waypoint x="630" y="250" />
        <di:waypoint x="685" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Auth_Join_di" bpmnElement="Flow_Auth_Join">
        <di:waypoint x="630" y="380" />
