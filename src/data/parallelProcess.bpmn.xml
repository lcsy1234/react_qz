        <di:waypoint x="790" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Finish_End_di" bpmnElement="Flow_Finish_End">
        <di:waypoint x="890" y="250" />
        <di:waypoint x="952" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
